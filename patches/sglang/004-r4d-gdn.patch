+        a.data_ptr(), b.data_ptr(), a.stride(0), a.dtype == torch.bfloat16,
+        A_log.data_ptr(), dt_bias.data_ptr(),
+        state_ptr, flat_slot, int(inter_ssm.stride(2)),
+        o.data_ptr(), cu.data_ptr(), sidx.data_ptr(), draft,
+        0,  # num_accepted
+        0, 0, 0.0, 0,  # 不折叠 gated RMSNorm：SGLang 的 norm 还在模型层
+        num_seqs, H, Hg, HK, HV, float(K ** -0.5), _SOFTPLUS_THRESHOLD, _stream(),
+    )
+    return o.view(1, T, H, HV)
