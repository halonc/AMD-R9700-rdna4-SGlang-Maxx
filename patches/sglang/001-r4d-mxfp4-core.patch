@@ -0,0 +1,134 @@
+"""SGLang quantisation config + dense LinearMethod for the MXFP4 RDNA4 kernel.
+
+Mixed checkpoints: this method only claims layers whose weight_scale is a uint8
+E8M0 plane (i.e. the layers nvfp4_to_mxfp4.py converted); everything else keeps
+whatever method it had (AWQ / FP8 / unquantised).
+"""
+import torch
+from torch import nn
+
+from sglang.srt.layers.quantization.base_config import (
+    LinearMethodBase,
+    QuantizationConfig,
+)
+from sglang.srt.layers.linear import LinearBase
+from sglang.srt.layers.parameter import ModelWeightParameter
+from sglang.srt.utils.common import set_weight_attrs
+
+from sglang.srt.hardware_backend.gpu.quantization import r4d_mxfp4 as M
+
+
+def _mxfp4_weight_loader(param, loaded_weight, shard_id=None, *args, **kwargs):
+    """Shape-adaptive loader.
+
+    Merged layers (qkv / gate_up) hand us one projection at a time, and SGLang derives
+    the split from the module's output_sizes; which axis that lands on depends on the
+    parameter's output_dim attribute.  Rather than assume, match the incoming chunk
+    against the parameter and place it on whichever axis it fits.
+    """
+    tgt, src = param.data, loaded_weight
+    if tuple(src.shape) == tuple(tgt.shape):
+        tgt.copy_(src)
+        return
+    _ORDER = {"q": 0, "k": 1, "v": 2, "qkv": 0, "z": 1, "b": 2, "a": 3,
+              "gate": 0, "up": 1, "gate_up": 0, "w": 0, "w1": 0, "w2": 1, "w3": 2}
+    if isinstance(shard_id, int):
+        idx = shard_id
+    else:
+        idx = _ORDER.get(str(shard_id).lower(), 0)
+    # axis 0 (rows) split?
+    if src.shape[-1] == tgt.shape[-1] and tgt.shape[0] % src.shape[0] == 0:
+        n = tgt.shape[0] // src.shape[0]
+        i = idx if idx < n else 0
+        tgt[i * src.shape[0]:(i + 1) * src.shape[0], :].copy_(src)
+        return
+    # axis 1 (columns) split?
+    if src.shape[0] == tgt.shape[0] and tgt.shape[1] % src.shape[1] == 0:
+        n = tgt.shape[1] // src.shape[1]
+        i = idx if idx < n else 0
+        tgt[:, i * src.shape[1]:(i + 1) * src.shape[1]].copy_(src)
+        return
+    # last resort: flat copy of whatever fits
+    flat = tgt.reshape(-1)
+    flat[: src.numel()].copy_(src.reshape(-1)[: flat.numel()])
+
+
+class R4DMxfp4Config(QuantizationConfig):
+    """Marker config so `--quantization r4d_mxfp4` selects the kernel."""
+
+    def __init__(self) -> None:
+        super().__init__()
+
+    def get_name(self) -> str:
+        return "r4d_mxfp4"
+
+    def get_supported_act_dtypes(self):
+        return [torch.bfloat16, torch.float16]
+
+    @classmethod
+    def get_min_capability(cls) -> int:
+        return 0
+
+    @staticmethod
+    def get_config_filenames():
+        return []
+
+    @classmethod
+    def from_config(cls, config):
+        return cls()
+
+    def get_scaled_act_names(self):
+        return []
+
+    def get_quant_method(self, layer, prefix: str):
+        if isinstance(layer, LinearBase):
+            return R4DMxfp4LinearMethod(self)
+        return None
+
+
+class R4DMxfp4LinearMethod(LinearMethodBase):
+    """weight [N, K/2] uint8 (E2M1) + weight_scale [K/32, N] uint8 (E8M0)."""
+
+    def __init__(self, quant_config: R4DMxfp4Config):
+        self.quant_config = quant_config
+
+    def create_weights(self, layer, input_size_per_partition, output_partition_sizes,
+                       input_size, output_size, params_dtype, **extra_weight_attrs):
+        out_size = sum(output_partition_sizes)
+        k = input_size_per_partition
+        w = ModelWeightParameter(
+            data=torch.empty(out_size, k // 2, dtype=torch.uint8),
+            input_dim=1, output_dim=0,
+            weight_loader=_mxfp4_weight_loader,
+        )
+        layer.register_parameter("weight", w)
+        ws = ModelWeightParameter(
+            data=torch.empty(k // 32, out_size, dtype=torch.uint8),
+            input_dim=0, output_dim=1,
+            weight_loader=_mxfp4_weight_loader,
+        )
+        layer.register_parameter("weight_scale", ws)
+
+    def process_weights_after_loading(self, layer) -> None:
+        layer.weight = nn.Parameter(layer.weight.data.contiguous(), requires_grad=False)
+        layer.weight_scale = nn.Parameter(layer.weight_scale.data.contiguous(), requires_grad=False)
+        layer.mxfp4_row_ref = M.make_row_ref(layer.weight_scale)
+        # The lm_head is 248320 wide, far past the decode kernel N cap, so it falls back to
+        # the prefill kernel: measured 226 GB/s against ~545 GB/s for N<=36864.  Split it
+        # along N at load time and use the decode kernel per piece (2 calls per step).
+        ch = M.build_chunks(layer.weight, layer.weight_scale, layer.mxfp4_row_ref)
+        if ch is not None:
+            layer.mxfp4_wc, layer.mxfp4_wsc, layer.mxfp4_refc = ch
+            print("[r4d.mxfp4] lm_head chunked N=%d -> %d x %d"
+                  % (layer.weight.shape[0], len(ch[0]), ch[0][0].shape[0]), flush=True)
+
+    def apply(self, layer, x, bias=None):
+        wc = getattr(layer, "mxfp4_wc", None)
+        if wc is not None and x.dim() == 2 and x.shape[0] <= M.R4D_DECODE_MAX_M:
+            out = M.mxfp4_linear_chunked(x, wc, layer.mxfp4_wsc, layer.mxfp4_refc,
+                                         layer.weight.shape[0])
+        else:
+            out = M.mxfp4_linear(x, layer.weight, layer.weight_scale, layer.mxfp4_row_ref)
+        if bias is not None:
+            out = out + bias
+        return out
