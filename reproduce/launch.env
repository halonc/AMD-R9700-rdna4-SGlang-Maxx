# The finalized launch configuration, as environment variables.
# These are the values that produced the headline numbers (see ../docs/FINDINGS.md).
# docker-compose.yml carries the same set; this file is the human-readable archive.

# --- GPU / runtime -------------------------------------------------------------
HIP_VISIBLE_DEVICES=0
ROCR_VISIBLE_DEVICES=0
PYTHONPATH=/opt/libr4d
SGLANG_DIR=/opt/sglang
ROCM_PATH=/opt/rocm
TVM_FFI_GPU_BACKEND=cuda
SGLANG_ENABLE_SPEC_V2=0
SGLANG_VLM_CACHE_SIZE_MB=0

# --- Tuning kill-switches (production values) ---------------------------------
# atiled fused-norm for prefill >= 513 tokens (Phase 1, 2026-10-07)
SGLANG_MXFP4_ATILED_MIN_M=513
# r4d GDN prefill trio for >= 513-token blocks (Phase 2, 2026-10-07)
SGLANG_R4D_GDN_MIN_T=513
# r4d verify-attention (on by default; 1 = enabled)
SGLANG_R4D_ATTN=1
# verify block size (Triton fallback path only)
SGLANG_VERIFY_BLOCK_N=64
# fragment-order weight permutation for the radiance decode GEMM
RADIANCE_MXFP4_WPERM=1
# fp8 embedding (frees ~1 GB; lets ctx reach the 229K band)
SGLANG_EMBED_FP8=1
# TP=1 JIT store_cache path is broken on RDNA4; disable it
SGLANG_RDNA4_DISABLE_STORE_CACHE=1
# MXFP4 draft conversion: OFF (accept 0.68 -> 0.25, net loss — see DEAD-ENDS row 5)
SGLANG_MXFP4_DRAFT=0
# 3-bit W3A4: OFF (rejected end-to-end — see DEAD-ENDS row 14)
SGLANG_W3=0

# --- Production red lines (do not change without re-measuring) ----------------
# CHUNK=2048, MEMF=0.94, MAX_RUN=1, MAMBA=16, CTX=182000
# --enable-cache-report, --sleep-on-idle, --image-processor-backend pil
# DPM stays "auto"

# Fastest whole rollback: set SGLANG_MXFP4_ATILED_MIN_M and SGLANG_R4D_GDN_MIN_T to 0.
